# Contact Hub deployment template.
# Copy to worker/wrangler.toml (gitignored) and replace only the resource IDs
# that are explicitly marked below. Never commit the generated wrangler.toml.

name = "contact-mail-hub"
main = "src/worker.ts"
compatibility_date = "2025-04-01"
compatibility_flags = ["nodejs_compat"]
keep_vars = true

# Contact Hub V1 is deployed as one Worker serving the Vue build and APIs.
[assets]
directory = "../frontend/dist/"
binding = "ASSETS"
run_worker_first = true

[env.staging]
name = "contact-mail-hub-staging"
workers_dev = true

[env.staging.vars]
APP_ENV = "staging"
CONTACT_MAIL_MODE = true
DEFAULT_LANG = "zh"
TITLE = "Private Contact Mail Hub — Staging"
CONTACT_ADMIN_SESSION_TTL_SECONDS = 14400
CONTACT_PROVIDER_HTTP_TIMEOUT_MS = 15000
CONTACT_DNS_CACHE_TTL_SECONDS = 3600
DISABLE_ADMIN_PASSWORD_CHECK = false

[[env.staging.d1_databases]]
binding = "DB"
database_name = "contact-mail-hub-staging"
database_id = "<STAGING_D1_ID>"

[[env.staging.r2_buckets]]
binding = "CONTACT_R2"
bucket_name = "contact-mail-hub-staging"

[env.production]
name = "contact-mail-hub-production"
workers_dev = false

[env.production.vars]
APP_ENV = "production"
CONTACT_MAIL_MODE = true
DEFAULT_LANG = "zh"
TITLE = "Private Contact Mail Hub"
CONTACT_ADMIN_SESSION_TTL_SECONDS = 14400
CONTACT_PROVIDER_HTTP_TIMEOUT_MS = 15000
CONTACT_DNS_CACHE_TTL_SECONDS = 3600
DISABLE_ADMIN_PASSWORD_CHECK = false

[[env.production.d1_databases]]
binding = "DB"
database_name = "contact-mail-hub-production"
database_id = "<PRODUCTION_D1_ID>"

[[env.production.r2_buckets]]
binding = "CONTACT_R2"
bucket_name = "contact-mail-hub-production"

# Secrets are intentionally absent from vars. Configure them per environment:
#   wrangler secret put JWT_SECRET --env staging
#   wrangler secret put ADMIN_PASSWORDS --env staging
# and repeat with independent values for production when production is approved.
# Provider credentials such as CONTACT_RESEND_*_API_KEY and
# CONTACT_SMTP_*_PASSWORD must also be Worker Secrets, never vars.
